{
  "name": "graph-note",
  "version": "0.1.0",
  "private": true,
  "description": "Draw the graphs written in notes, and edit them by typing or by dragging the drawing.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspace packages/obsidian",
    "typecheck": "tsc -p packages/obsidian --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "1.13.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0"
  }
}
