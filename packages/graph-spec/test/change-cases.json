        ["delete-link", null]
      ],
      "after": [
        "(grace:Person {name: 'Grace'}),",
        "(notes:Book {title: 'Notes on the engine', pages: 66}),",
        "(late:Book {title: 'A late book'}),",
        "(grace)-[:WROTE]->(late)"
      ]
    },
    {
      "name": "a reason is a hint, never needed",
      "body": ["//@ reason: tidy", "MATCH (p:Person {id: 'grace'}) DELETE p"],
