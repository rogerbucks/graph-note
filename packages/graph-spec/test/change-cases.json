{
  "about": "Change sets that DELETE and SET (graph spec section 24, 16 Oct 2026). Both readers run these cases: packages/graph-spec/test/changes.test.mjs and python/graph_spec/tests/test_changes.py. The base graph is head followed by base_rest, one block. A case names its author (by, ada unless given), what it was made against (against, the base's state unless given), the lines after the header (body), the checks it fails (failed, by the keys in labels), the changes read from it in order (changes: op and reason) and the graph it leaves (after: the lines that follow head, so head and after read alone give the same state; null when it is refused; a case that changes a line of head gives it in head_changed, as [old line, new line] pairs, applied to head before the state is read). A case with same_id_as reads a change with the id of one in that case; every other change has an id of its own.",
  "labels": {
    "statement": "each DELETE and SET is its own statement and names exactly one target (§24)",
    "basis": "only the header says what it was made against and who made it (§24)",
    "find": "each DELETE and SET finds its one target in the graph (§24)",
    "dangling": "a DELETE leaves no link without its end; DETACH DELETE removes a thing with its links (§24)",
    "current": "it was made against the graph as it stands",
    "model": "a model adds no record and no cache (§24 rule 5)",
    "record": "it never removes or changes a record or a cache (§24 rule 4)",
    "generated": "an added WAS_GENERATED_BY comes from a thing the set adds, to an activity of the set's own author (§24)",
    "unknown": "its author stranger is a known person or model",
    "cache": "it adds no cache — a claim's likelihood, confidence and status are the engine's (§24 rule 5)",
    "plan": "after it, §11 req:11.had-plan: every activity that derives an element by a rule links to that rule with HAD_PLAN",
    "attributed": "after it, §24 req:24.prov-attributed: every WAS_ATTRIBUTED_TO link goes to a Person, Organization or SoftwareAgent (a Model counts as one)",
    "revision": "after it, §12 req:12.prov-revision: every successor was generated after what it supersedes"
  },
  "head": [
    "// graph: library",
    "INSERT",
    "(t_book:ElementType {id: 'type:Book', name: 'Book', kind: 'node'}),",
    "(t_person:ElementType {id: 'type:Person', name: 'Person', kind: 'node'}),",
    "(t_model:ElementType {id: 'type:Model', name: 'Model', kind: 'node'}),",
    "(t_wrote:ElementType {id: 'type:WROTE', name: 'WROTE', kind: 'edge', reading: 'wrote', reverse_name: 'written by'}),",
    "(library_schema:GraphMeta {id: 'meta:library', graph: 'library', schema: 'library@1'}),",
    "(library_schema)-[:DECLARES]->(t_book),",
    "(library_schema)-[:DECLARES]->(t_person),",
    "(library_schema)-[:DECLARES]->(t_model),",
    "(library_schema)-[:DECLARES]->(t_wrote),",
    "(t_event:ElementType {id: 'type:Event', name: 'Event', kind: 'node'}),",
    "(library_schema)-[:DECLARES]->(t_event),",
    "(t_delivery:ElementType {id: 'type:Delivery', name: 'Delivery', kind: 'node'}),",
    "(t_delivered:ElementType {id: 'type:DELIVERED', name: 'DELIVERED', kind: 'edge', reading: 'delivered', reverse_name: 'delivered by'}),",
    "(library_schema)-[:DECLARES]->(t_delivery),",
    "(library_schema)-[:DECLARES]->(t_delivered),",
    "(ada:Person {name: 'Ada'}),",
    "(bot:Model {name: 'Drafter'}),",
    "(t_activity:ElementType {id: 'type:Activity', name: 'Activity', kind: 'node'}),",
    "(t_assessment:ElementType {id: 'type:Assessment', name: 'Assessment', kind: 'node'}),",
    "(t_assoc:ElementType {id: 'type:ASSOCIATED_WITH', name: 'ASSOCIATED_WITH', kind: 'edge', reading: 'associated with', reverse_name: 'associates'}),",
    "(t_gen:ElementType {id: 'type:WAS_GENERATED_BY', name: 'WAS_GENERATED_BY', kind: 'edge', reading: 'was generated by', reverse_name: 'generated'}),",
    "(library_schema)-[:DECLARES]->(t_activity),",
    "(library_schema)-[:DECLARES]->(t_assessment),",
    "(library_schema)-[:DECLARES]->(t_assoc),",
    "(library_schema)-[:DECLARES]->(t_gen),",
    "(figure:Book {title: 'Total'}),",
    "(engine_run:Activity {name: 'Engine run'}),",
    "(bot_run:Activity {name: 'Drafter run'}),",
    "(figure)-[:WAS_GENERATED_BY]->(engine_run),",
    "(bot_run)-[:ASSOCIATED_WITH]->(bot),",
    "(t_rule:ElementType {id: 'type:Rule', name: 'Rule', kind: 'node'}),",
    "(t_supersedes:ElementType {id: 'type:SUPERSEDES', name: 'SUPERSEDES', kind: 'edge', reading: 'supersedes', reverse_name: 'superseded by'}),",
    "(library_schema)-[:DECLARES]->(t_rule),",
    "(library_schema)-[:DECLARES]->(t_supersedes),",
    "(total_rule:Rule {name: 'Total', rule: 'rule:total@1'}),",
    "(engine_run)-[:HAD_PLAN]->(total_rule),",
    "(plain_run:Activity {name: 'Typed in by hand'}),",
    "(ledger:Book {title: 'Ledger'}),",
    "(ledger)-[:WAS_GENERATED_BY]->(plain_run),",
    "(bot_planned_run:Activity {name: 'Drafter planned run'}),",
    "(bot_planned_run)-[:ASSOCIATED_WITH]->(bot),",
    "(bot_planned_run)-[:HAD_PLAN]->(total_rule),",
    "(planned:Book {title: 'Planned'}),",
    "(planned)-[:WAS_GENERATED_BY]->(bot_planned_run),",
    "(acme:Organization {name: 'Acme'}),",
    "(importer:SoftwareAgent {name: 'Importer'}),",
    "(edition1:Book {title: 'Edition one', generated_at: DATETIME '2026-09-01T00:00:00+00:00'}),",
    "(sale:Event {title: 'A sale', amount: 10}),"
  ],
