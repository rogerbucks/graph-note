      "changes": [["delete-thing", "tidy"]],
      "same_id_as": "delete a thing that has no links",
      "after": [
        "(notes:Book {title: 'Notes on the engine', pages: 60}),",
        "(atlas:Book {title: 'Atlas'}),",
        "(ada)-[:WROTE]->(notes),",
