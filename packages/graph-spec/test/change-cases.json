{
  "about": "Change sets that DELETE and SET (graph spec section 24, 16 Oct 2026). Both readers run these cases: packages/graph-spec/test/changes.test.mjs and python/graph_spec/tests/test_changes.py. The base graph is head followed by base_rest, one block. A case names its author (by, ada unless given), what it was made against (against, the base's state unless given), the lines after the header (body), the checks it fails (failed, by the keys in labels), the changes read from it in order (changes: op and reason) and the graph it leaves (after: the lines that follow head, so head and after read alone give the same state; null when it is refused). A case with same_id_as reads a change with the id of one in that case; every other change has an id of its own.",
  "labels": {
    "statement": "each DELETE and SET is its own statement and names exactly one target (§24)",
    "basis": "only the header says what it was made against and who made it (§24)",
    "find": "each DELETE and SET finds its one target in the graph (§24)",
    "dangling": "a DELETE leaves no link without its end; DETACH DELETE removes a thing with its links (§24)",
    "current": "it was made against the graph as it stands",
    "model": "a model adds no record and no cache (§24 rule 5)",
    "record": "it never removes or changes a record or a cache (§24 rule 4)",
    "cache": "it adds no cache — a claim's likelihood, confidence and status are the engine's (§24 rule 5)"
  },
  "head": [
    "// graph: library",
    "INSERT",
    "(t_book:ElementType {id: 'type:Book', name: 'Book', kind: 'node'}),",
    "(t_person:ElementType {id: 'type:Person', name: 'Person', kind: 'node'}),",
    "(t_model:ElementType {id: 'type:Model', name: 'Model', kind: 'node'}),",
    "(t_wrote:ElementType {id: 'type:WROTE', name: 'WROTE', kind: 'edge', reading: 'wrote', reverse_name: 'written by'}),",
    "(library_schema:GraphMeta {id: 'meta:library', graph: 'library', schema: 'library@1'}),",
    "(library_schema)-[:DECLARES]->(t_book),",
    "(library_schema)-[:DECLARES]->(t_person),",
    "(library_schema)-[:DECLARES]->(t_model),",
    "(library_schema)-[:DECLARES]->(t_wrote),",
    "(t_event:ElementType {id: 'type:Event', name: 'Event', kind: 'node'}),",
    "(library_schema)-[:DECLARES]->(t_event),",
    "(ada:Person {name: 'Ada'}),",
    "(bot:Model {name: 'Drafter'}),",
    "(sale:Event {title: 'A sale', amount: 10}),"
  ],
  "base_rest": [
    "(grace:Person {name: 'Grace'}),",
    "(notes:Book {title: 'Notes on the engine', pages: 60}),",
    "(atlas:Book {title: 'Atlas'}),",
    "(ada)-[:WROTE]->(notes),",
    "(ada)-[:WROTE]->(atlas)"
  ],
  "cases": [
    {
      "name": "delete a link by its two ends and its type",
      "body": ["MATCH (a {id: 'ada'})-[r:WROTE]->(b {id: 'atlas'}) DELETE r"],
      "failed": [],
      "changes": [["delete-link", null]],
      "after": [
        "(grace:Person {name: 'Grace'}),",
        "(notes:Book {title: 'Notes on the engine', pages: 60}),",
        "(atlas:Book {title: 'Atlas'}),",
        "(ada)-[:WROTE]->(notes)"
      ]
    },
    {
      "name": "delete a thing that has no links",
      "body": ["MATCH (p:Person {id: 'grace'}) DELETE p"],
      "failed": [],
      "changes": [["delete-thing", null]],
      "after": [
        "(notes:Book {title: 'Notes on the engine', pages: 60}),",
        "(atlas:Book {title: 'Atlas'}),",
        "(ada)-[:WROTE]->(notes),",
        "(ada)-[:WROTE]->(atlas)"
      ]
    },
    {
      "name": "detach delete a thing that has a link",
      "body": ["MATCH (b:Book {id: 'atlas'}) DETACH DELETE b"],
      "failed": [],
      "changes": [["detach-delete-thing", null, [["ada", "WROTE", "atlas"]]]],
      "after": [
        "(grace:Person {name: 'Grace'}),",
        "(notes:Book {title: 'Notes on the engine', pages: 60}),",
        "(ada)-[:WROTE]->(notes)"
      ]
    },
    {
      "name": "delete a thing that still has a link is refused",
      "body": ["MATCH (b:Book {id: 'atlas'}) DELETE b"],
      "failed": ["dangling"],
      "changes": [["delete-thing", null]],
      "after": null
    },
    {
      "name": "set a value, named by the thing's name",
      "body": ["SET notes.pages = 66"],
      "failed": [],
      "changes": [["set-thing", null]],
      "after": [
        "(grace:Person {name: 'Grace'}),",
        "(notes:Book {title: 'Notes on the engine', pages: 66}),",
        "(atlas:Book {title: 'Atlas'}),",
        "(ada)-[:WROTE]->(notes),",
        "(ada)-[:WROTE]->(atlas)"
      ]
    },
    {
      "name": "set the same value, written with a MATCH on two lines",
      "body": ["MATCH (b:Book {id: 'notes'})", "SET b.pages = 66"],
      "failed": [],
      "changes": [["set-thing", null]],
      "same_id_as": "set a value, named by the thing's name",
      "after": [
        "(grace:Person {name: 'Grace'}),",
        "(notes:Book {title: 'Notes on the engine', pages: 66}),",
        "(atlas:Book {title: 'Atlas'}),",
        "(ada)-[:WROTE]->(notes),",
        "(ada)-[:WROTE]->(atlas)"
      ]
    },
    {
      "name": "set several values on one thing",
      "body": ["SET notes.pages = 66, notes.edition = 2"],
      "failed": [],
      "changes": [["set-thing", null]],
      "after": [
        "(grace:Person {name: 'Grace'}),",
        "(notes:Book {title: 'Notes on the engine', pages: 66, edition: 2}),",
        "(atlas:Book {title: 'Atlas'}),",
        "(ada)-[:WROTE]->(notes),",
        "(ada)-[:WROTE]->(atlas)"
      ]
    },
    {
      "name": "set a value on a link",
      "body": ["MATCH (a {id: 'ada'})-[r:WROTE]->(b {id: 'notes'}) SET r.year = 1843"],
      "failed": [],
      "changes": [["set-link", null]],
      "after": [
        "(grace:Person {name: 'Grace'}),",
        "(notes:Book {title: 'Notes on the engine', pages: 60}),",
        "(atlas:Book {title: 'Atlas'}),",
        "(ada)-[:WROTE {year: 1843}]->(notes),",
        "(ada)-[:WROTE]->(atlas)"
      ]
    },
    {
      "name": "an addition, a removal and a change in one set, with their reasons",
      "body": [
        "(late:Book {title: 'A late book'}),",
        "(grace)-[:WROTE]->(late)",
