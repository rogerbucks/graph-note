        "MATCH (b:Book {id: 'atlas'}) DETACH DELETE b",
        "MATCH (a {id: 'ada'})-[r:WROTE]->(b {id: 'notes'}) DELETE r"
      ],
      "failed": [],
      "changes": [
        ["set-thing", "the page count was a draft figure"],
