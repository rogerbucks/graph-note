        "edges": [
          ["sam", "PLAYS", "clerk"],
          ["clerk", "OWNS", "ship"],
          ["ship", "USES", "stock"]
        ]
      },
      "call": "coreOfEight",
      "args": [],
      "expected": {
        "kinds": ["Step", "Dependency", "Condition", "Decision", "Event", "Actor", "Artefact", "Resource"],
        "kind": {
          "ship": "Step",
          "stock": "Resource",
          "clerk": "Actor",
          "pat": "Actor"
        },
        "flags": [
          ["ninth-kind", "kpi", "Metric"],
          ["ninth-kind", "when", "Time"],
          ["owner-as-property", "ship", "ops"],
          ["person-as-role", "pat", ""]
