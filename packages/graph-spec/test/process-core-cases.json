          ],
          ["stock", ["Resource"], {}],
          ["clerk", ["Actor"], {}],
          ["sam", ["Person"], {}],
          ["pat", ["Actor", "Person"], {}],
          ["kpi", ["Metric"], {}],
          ["when", ["Time"], {}]
