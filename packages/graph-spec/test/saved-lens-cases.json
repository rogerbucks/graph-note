            }
          ],
          [
            "d2",
            ["Decision"],
            {
              "status": "closed"
            }
          ],
          ["d3", ["Decision"], {}],
          [
            "q1",
            ["Question"],
            {
              "status": "open"
            }
          ]
        ],
        "edges": []
