    {
      "name": "a lens is flagged when a schema it uses changes",
      "graph": {
        "nodes": [
          [
            "open_decisions",
            ["Lens"],
            {
              "name": "Open decisions",
              "query": "Decision WHERE status == 'open'",
              "altitude": "board",
              "schemas": "decision@1"
            }
          ],
          [
            "everything",
            ["Lens"],
            {
              "name": "Everything",
              "query": "*"
            }
          ],
          [
            "d1",
            ["Decision"],
            {
              "status": "open"
            }
          ],
          [
            "d2",
            ["Decision"],
            {
              "status": "closed"
            }
          ],
          ["d3", ["Decision"], {}],
          [
            "q1",
            ["Question"],
            {
              "status": "open"
            }
          ]
        ],
        "edges": []
      },
      "call": "runLens",
      "args": [
        "open_decisions",
        {
          "schemas": {
            "decision": "decision@2"
          }
        }
      ],
      "expected": {
        "lens": "open_decisions",
        "things": ["d1"],
        "altitude": "board",
        "flags": [["schema-changed", "decision@1 -> decision@2"]]
      }
    },
    {
      "name": "a lens names its schemas as comma-separated text",
      "graph": {
        "nodes": [
          [
            "risks",
            ["Lens"],
            {
              "name": "Risks",
              "query": "Risk",
              "schemas": "decision@1, risk@2"
            }
          ],
          ["r1", ["Risk"], {}]
        ],
        "edges": []
      },
      "call": "runLens",
      "args": [
        "risks",
        {
          "schemas": {
            "decision": "decision@1",
            "risk": "risk@3"
          }
        }
      ],
      "expected": {
        "lens": "risks",
        "things": ["r1"],
        "altitude": null,
        "flags": [["schema-changed", "risk@2 -> risk@3"]]
      }
    },
    {
      "name": "a lens holding data is flagged",
      "graph": {
        "nodes": [
          [
            "bad",
            ["Lens"],
            {
              "name": "Bad",
              "query": "Decision",
              "total": 12
            }
          ],
          ["d1", ["Decision"], {}]
        ],
        "edges": [["bad", "HOLDS", "d1"]]
      },
      "call": "lensesOf",
      "args": [{}],
      "expected": [
        {
          "id": "bad",
          "name": "Bad",
          "query": "Decision",
          "altitude": null,
          "schemas": [],
          "topics": ["Decision"],
          "flags": [
            ["lens-holds-data", "total"],
            ["lens-holds-data", "HOLDS d1"]
          ]
        }
      ]
    },
