{
  "about": "Shared cases for lenses as graph data (editor spec §33, lens_is_saved_query). Each case calls lensesOf or runLens of packages/graph-spec/src/lenses/saved-lenses.js on its graph, with its args, and the Python twin must give the same answer. Made once by the JavaScript library.",
  "cases": [
    {
      "name": "a lens finds what its query asks for, with its default altitude",
      "graph": {
        "nodes": [
          [
            "open_decisions",
            ["Lens"],
            {
              "name": "Open decisions",
              "query": "Decision WHERE status == 'open'",
              "altitude": "board",
              "schemas": "decision@1"
            }
          ],
          [
            "everything",
            ["Lens"],
            {
              "name": "Everything",
              "query": "*"
            }
          ],
          [
            "d1",
            ["Decision"],
            {
              "status": "open"
            }
          ],
          [
            "d2",
            ["Decision"],
            {
              "status": "closed"
            }
          ],
          ["d3", ["Decision"], {}],
          [
            "q1",
            ["Question"],
            {
              "status": "open"
            }
          ]
        ],
        "edges": []
      },
      "call": "runLens",
      "args": ["open_decisions", {}],
      "expected": {
        "lens": "open_decisions",
        "things": ["d1"],
        "altitude": "board",
        "flags": []
      }
    },
    {
      "name": "a lens opened after an edit answers fresh",
      "graph": {
