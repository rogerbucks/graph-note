            }
          ],
          [
            "d2",
            ["Decision"],
            {
              "status": "open"
            }
          ],
          ["d3", ["Decision"], {}],
          [
            "q1",
            ["Question"],
            {
              "status": "open"
            }
          ]
        ],
        "edges": []
      },
      "call": "runLens",
      "args": ["open_decisions", {}],
      "expected": {
        "lens": "open_decisions",
        "things": ["d1", "d2"],
        "altitude": "board",
        "flags": []
      }
    },
    {
      "name": "a lens for every thing finds every thing but lenses",
