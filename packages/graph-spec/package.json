{
  "name": "@graph-note/graph-spec",
  "version": "0.4.1",
  "private": true,
  "description": "Reads graph blocks in the document profile and checks them against the graph spec's rules, in plain JavaScript with no dependencies.",
  "license": "MIT",
  "type": "commonjs",
  "main": "src/graph-spec-check.js",
  "types": "src/graph-spec.d.ts",
  "scripts": {
    "build": "node esbuild.check.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/graph-spec.d.ts",
      "default": "./src/graph-spec-check.js"
    },
    "./src/graph-layout.js": {
      "types": "./src/graph-layout-types.d.ts",
      "default": "./src/graph-layout.js"
    },
    "./package.json": "./package.json"
  }
}
