        [
          "// graph: trip",
          "(home:Place {name: 'Home'}),",
          "(park:Place {name: 'The park'}),",
          "(cafe:Cafe {name: 'Cafe'}),",
          "(guide:Source {name: 'The guide'}),",
          "(green:Tag {name: 'Green'}),",
          "(home)-[:NEAR]->(park),",
          "(cafe)-[:SERVES]->(park),",
          "(home)-[:CITES]->(guide),",
          "(park)-[:TAGGED]->(green)"
        ],
        ["// graph: trip_style · STYLE trip", "(f1:Flow {motion: 'dashes', means: 'the visit goes this way'})"]
      ]
    },
    {
      "name": "a dot on one relationship type, kept still in a view, drawn in that view",
      "view": "quiet",
      "blocks": [
        [
          "// graph: trip",
          "(home:Place {name: 'Home'}),",
          "(park:Place {name: 'The park'}),",
          "(lake:Place {name: 'The lake'}),",
