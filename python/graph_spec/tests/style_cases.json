{
  "about": "Graphs whose style graph hides or shows arrowheads (editor spec §15: arrows_switchable, arrows_both_renderers) and shows properties inline (§14: properties_switch, properties_readable, crowded_properties), drawn the same by the plugin's core and by graph_svg.py. Each case is a note's gql blocks, each block a list of lines, and the view it is drawn in, if any (its name only: the whole graph is drawn, styled as that view is). For every case both give the same problems reading each style, the same links drawn without their arrowheads, the same rows shown inline, and, for every graph drawn, the same Graphviz source in each direction laid out, byte for byte. The expected answers are the core's, run live: packages/core/test/layout-parity.test.js holds graph_svg.py to the core on these cases, and tests/test_graph_svg_styled.py does the same from the Python side.",
  "cases": [
    {
      "name": "arrowheads hidden for the whole graph, the link drawn backwards too",
      "blocks": [
        [
          "// graph: trip",
          "(home:Place {name: 'Home'}),",
          "(park:Place {name: 'The park'}),",
          "(cafe:Cafe {name: 'Cafe'}),",
          "(guide:Source {name: 'The guide'}),",
          "(green:Tag {name: 'Green'}),",
          "(home)-[:NEAR]->(park),",
          "(cafe)-[:SERVES]->(park),",
          "(home)-[:CITES]->(guide),",
          "(park)-[:TAGGED]->(green)"
        ],
        ["// graph: trip_style · STYLE trip", "(a1:Arrows {arrowheads: 'hide'})"]
      ]
    },
    {
      "name": "arrowheads hidden for one relationship type, and shown again for it in a view, drawn in that view",
      "view": "walks",
      "blocks": [
        [
          "// graph: trip",
          "(home:Place {name: 'Home'}),",
          "(park:Place {name: 'The park'}),",
          "(lake:Place {name: 'The lake'}),",
          "(home)-[:NEAR]->(park),",
          "(park)-[:NEAR]->(lake),",
          "(home)-[:FACES]->(lake)"
        ],
        [
          "// graph: trip_style · STYLE trip",
          "(a1:Arrows {arrowheads: 'hide'}),",
          "(a2:Arrows {arrowheads: 'show', type: 'NEAR', view: 'walks'})"
        ]
      ]
    },
    {
      "name": "arrowheads hidden in one view only, drawn as the whole graph",
      "blocks": [
        [
          "// graph: trip",
          "(home:Place {name: 'Home'}),",
          "(park:Place {name: 'The park'}),",
          "(home)-[:NEAR]->(park)"
        ],
        ["// graph: trip_style · STYLE trip", "(a1:Arrows {arrowheads: 'hide', view: 'walks'})"]
      ]
    },
    {
      "name": "properties of things shown inline by kind and by thing: text, numbers, a date, an instant, true and false, and text to escape",
      "blocks": [
        [
          "// graph: trip",
          "(home:Place {name: 'Home', rooms: 4, open: TRUE, size: 1.5, built: DATE '1901-05-01'}),",
          "(park:Place {name: 'The park', rooms: 0, open: FALSE, size: 1e21, since: DATETIME '2026-10-06T09:30:00+01:00'}),",
          "(cafe:Cafe {name: 'Cafe', note: 'Tea & <cake> \"fresh\" 🍰', tiny: 0.0000001, big: 120000000000000000000000}),",
          "(home)-[:NEAR]->(park),",
          "(cafe)-[:SERVES]->(park)"
        ],
        [
          "// graph: trip_style · STYLE trip",
          "(s1:Show {property: 'rooms', kind: 'Place'}),",
          "(s2:Show {property: 'open', kind: 'Place'}),",
          "(s3:Show {property: 'size', kind: 'Place'}),",
          "(s4:Show {property: 'built', thing: 'home'}),",
          "(s5:Show {property: 'since', thing: 'park'}),",
          "(s6:Show {property: 'note', kind: 'Cafe'}),",
          "(s7:Show {property: 'tiny', thing: 'cafe'}),",
          "(s8:Show {property: 'big', thing: 'cafe'})"
        ]
      ]
    },
    {
      "name": "properties of links shown inline, on a link drawn backwards and on one with its arrowhead hidden",
      "blocks": [
        [
          "// graph: trip",
          "(home:Place {name: 'Home'}),",
          "(park:Place {name: 'The park'}),",
          "(cafe:Cafe {name: 'Cafe'}),",
          "(guide:Source {name: 'The guide'}),",
          "(green:Tag {name: 'Green'}),",
          "(home)-[:NEAR {miles: 1.5, by: 'foot'}]->(park),",
          "(cafe)-[:SERVES {since: DATE '2020-01-01'}]->(park),",
          "(home)-[:CITES {page: 12}]->(guide),",
          "(park)-[:TAGGED {by: 'Ann & Bob'}]->(green)"
        ],
        [
          "// graph: trip_style · STYLE trip",
          "(s1:Show {property: 'miles', type: 'NEAR'}),",
          "(s2:Show {property: 'by', type: 'NEAR'}),",
          "(s3:Show {property: 'by', type: 'TAGGED'}),",
          "(s4:Show {property: 'since', type: 'SERVES'}),",
          "(a1:Arrows {arrowheads: 'hide', type: 'NEAR'})"
        ]
      ]
    },
    {
      "name": "a crowded box says how many properties are hidden, a long value counted by the rows it wraps to",
      "blocks": [
        [
          "// graph: venue",
          "(hall:Venue {name: 'Hall', a1: 'one', a2: 'two', a3: 'three', a4: 'four', a5: 'five'}),",
          "(room:Venue {name: 'Room', a1: 'one', note: 'a long note that wraps over more than one row of its box'}),",
