          "(s9:Show {property: 'c', type: 'HAS'}),",
          "(s10:Show {property: 'd', type: 'HAS'}),",
          "(s11:Show {property: 'e', type: 'HAS'})"
        ]
      ]
    },
    {
      "name": "switched on for the graph and off in a view, drawn in that view, with a kind switched on there alone",
      "view": "quiet",
      "blocks": [
        [
          "// graph: trip",
          "(home:Place {name: 'Home', open: 'always'}),",
          "(park:Place {name: 'The park', open: 'dawn'}),",
          "(cafe:Cafe {name: 'Cafe', open: '8am'}),",
          "(home)-[:NEAR {miles: 2}]->(park),",
