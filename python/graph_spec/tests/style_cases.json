        ],
        ["// graph: reader_style · STYLE reader", "(s1:Show {property: 'price', kind: 'Option'})"]
      ]
    },
    {
      "name": "a graph typed by a shared schema in a block of its own: its links read in the schema's words, with their properties shown and arrowheads hidden",
      "blocks": [
        [
          "// graph: shared · SCHEMA shared_reader",
          "(t:Meta:ElementType {name: 'SEES', kind: 'edge', reading: 'can see', reverse_name: 'is seen by'}),",
