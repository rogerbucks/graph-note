          "(s3:Show {property: 'open', kind: 'Cafe', view: 'quiet'}),",
          "(s4:Show {property: 'miles', type: 'NEAR', inline: 'off'})"
        ]
      ]
    },
    {
      "name": "properties, arrowheads and nudges together: a group, a direction, rows inline and links without heads",
      "blocks": [
        [
          "// graph: team",
          "(ann:Person {name: 'Ann', role: 'lead'}), (bob:Person {name: 'Bob', role: 'design'}),",
          "(t1:Team {name: 'One', size: 2}),",
          "(ann)-[:IN {since: 2020}]->(t1), (bob)-[:IN {since: 2024}]->(t1)"
        ],
        [
          "// graph: team_style · STYLE team",
          "(g1:Nudge {word: 'group', thing: 'ann', group: 'Early'}),",
          "(n1:Nudge {word: 'direction', direction: 'TB'}),",
          "(s1:Show {property: 'role', kind: 'Person'}),",
          "(s2:Show {property: 'size', thing: 't1'}),",
          "(s3:Show {property: 'since', type: 'IN'}),",
          "(a1:Arrows {arrowheads: 'hide', type: 'IN'})"
        ]
      ]
    },
    {
      "name": "a thing drawn under a suggested name shows its properties below its text and its mark",
      "blocks": [
        [
          "// graph: reader",
